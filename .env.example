# copy to .env
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5544/portfolio

# --- auth (Google OAuth + allowlist) ---
# OAuth 2.0 Web client id from Google Cloud Console (also set as VITE_GOOGLE_CLIENT_ID for the web build)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# strong random key for signing session cookies — generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# comma-separated list of emails allowed to sign in
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
# comma-separated subset of ALLOWED_EMAILS allowed to see the Spending section.
# Empty or unset => nobody sees it and /api/spending/* returns 403 (fail closed).
SPENDING_EMAILS=you@gmail.com
# CORS / allowed front-end origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# cookie Secure flag — true in prod (HTTPS), false for local http dev
COOKIE_SECURE=false
# LOCAL DEV ONLY: skip Google sign-in entirely (every request treated as dev@localhost).
# Force-disabled on Vercel regardless of this value, so it can never unlock prod. Leave unset/false
# unless you want to run the API+web without OAuth configured.
DEV_AUTH_BYPASS=false
